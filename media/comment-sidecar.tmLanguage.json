{
  "scopeName": "source.comment-sidecar",
  "patterns": [
    {
      "match": "^#.*$",
      "name": "comment.line.number-sign"
    },
    {
      "match": "^(---|\\+\\+\\+).*$",
      "name": "entity.name.filename"
    },
    {
      "match": "^@@.*$",
      "name": "meta.diff.header"
    },
    {
      "match": "^@anchor.*$",
      "name": "comment.line.metadata.comment-sidecar"
    },
    {
      "match": "^\\+//.*$",
      "name": "markup.inserted.diff"
    }
  ]
}
