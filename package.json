{
  "name": "line-comments",
  "displayName": "Line Comments",
  "description": "Per-line comments in sibling .comment patches. Hover context, line tracking, review warnings, and agent CLI/MCP access without changing source.",
  "version": "0.1.3",
  "publisher": "line-comments-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.17.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "comments",
    "context",
    "diff",
    "agents",
    "mcp"
  ],
  "main": "./src/extension/extension.js",
  "bin": {
    "lc": "./src/cli.js",
    "line-comments-mcp": "./src/mcp.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only hover works. Comment creation, editing and tracked sidecar writes require workspace trust."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-syntax.js",
    "benchmark": "node scripts/benchmark.js",
    "package": "python3 scripts/package-vsix.py",
    "test:aliases": "node scripts/test-aliases.js",
    "clean": "node scripts/clean.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "line-comments-patch",
        "aliases": [
          "Line Comment Patch"
        ],
        "extensions": [
          ".comment"
        ]
      }
    ],
    "grammars": [
      {
        "language": "line-comments-patch",
        "scopeName": "source.line-comments",
        "path": "./media/line-comments.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "lineComments.add",
        "title": "Line Comments: Add Comment at Line"
      },
      {
        "command": "lineComments.edit",
        "title": "Line Comments: Edit Comment"
      },
      {
        "command": "lineComments.remove",
        "title": "Line Comments: Delete Comment"
      },
      {
        "command": "lineComments.review",
        "title": "Line Comments: Mark Comment Reviewed"
      },
      {
        "command": "lineComments.reanchor",
        "title": "Line Comments: Reattach Comment to This Line"
      },
      {
        "command": "lineComments.openSidecar",
        "title": "Line Comments: Open .comment Patch"
      },
      {
        "command": "lineComments.preview",
        "title": "Line Comments: Open Annotated Preview"
      },
      {
        "command": "lineComments.copy",
        "title": "Line Comments: Copy Annotated Selection"
      },
      {
        "command": "lineComments.list",
        "title": "Line Comments: List File Comments"
      },
      {
        "command": "lineComments.check",
        "title": "Line Comments: Check Workspace"
      },
      {
        "command": "lineComments.copyRules",
        "title": "Line Comments: Copy Agent Instructions"
      },
      {
        "command": "lineComments.copyMcp",
        "title": "Line Comments: Copy Cursor MCP Configuration"
      },
      {
        "command": "lineComments.compact",
        "title": "Line Comments: Remove Copied Code from .comment"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lineComments.add",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "lineComments@1"
        },
        {
          "command": "lineComments.edit",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "lineComments@2"
        },
        {
          "command": "lineComments.preview",
          "when": "resourceScheme == file",
          "group": "lineComments@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "lineComments.add",
        "key": "ctrl+alt+;",
        "mac": "cmd+alt+;",
        "when": "editorTextFocus && resourceScheme == file && isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Line Comments",
      "properties": {
        "lineComments.showMarkers": {
          "type": "boolean",
          "default": true,
          "description": "Show the external-comment marker. Enabled by default. Use markerStyle to choose the labeled ring or ring only."
        },
        "lineComments.markerStyle": {
          "type": "string",
          "enum": [
            "label",
            "icon",
            "off"
          ],
          "default": "label",
          "enumDescriptions": [
            "Dashed circle and comment text: ◌ comment.",
            "Dashed circle only: ◌.",
            "Hide markers; comments are still available on hover."
          ],
          "description": "Annotation marker appearance. Review markers append !."
        },
        "lineComments.showHoverMetadata": {
          "type": "boolean",
          "default": false,
          "description": "Include annotation IDs, attachment status and revision details in hovers. Off by default; review warnings remain visible."
        },
        "lineComments.highlightStyle": {
          "type": "string",
          "enum": [
            "line",
            "underline",
            "off"
          ],
          "default": "line",
          "enumDescriptions": [
            "Subtle whole-line tint and left edge; amber when review is needed.",
            "Underline annotated code without a line background.",
            "Do not highlight annotated lines; hover remains available."
          ],
          "description": "How annotated source lines are highlighted. Does not replace syntax colors or change source text."
        }
      }
    },
    "colors": [
      {
        "id": "lineComments.highlightBackground",
        "description": "Background for lines with external comments. Use transparency.",
        "defaults": {
          "dark": "#4CA6FF12",
          "light": "#1473E60D",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "lineComments.highlightBorder",
        "description": "Left edge or underline for lines with external comments.",
        "defaults": {
          "dark": "#71B7FF88",
          "light": "#1668BD88",
          "highContrast": "contrastBorder",
          "highContrastLight": "contrastBorder"
        }
      },
      {
        "id": "lineComments.reviewBackground",
        "description": "Background for comments needing review. Use transparency.",
        "defaults": {
          "dark": "#E6AF2E16",
          "light": "#BA7B1010",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      },
      {
        "id": "lineComments.reviewBorder",
        "description": "Left edge or underline for comments needing review.",
        "defaults": {
          "dark": "#E6AF2EA0",
          "light": "#9C610CB0",
          "highContrast": "editorWarning.foreground",
          "highContrastLight": "editorWarning.foreground"
        }
      }
    ]
  }
}
